# API keys for RoboQuest. Copy to keys.env, fill in the ones you use, keep it private:
#   cp keys.env.example keys.env && chmod 600 keys.env
# Pass it with --env-file keys.env (or export the variables instead). Each run reads only its provider's variable;
# keys.env is ignored by git.

# --model openai/...
OPENAI_API_KEY=
# --model openrouter/...
OPENROUTER_API_KEY=
# --model anthropic/...
ANTHROPIC_API_KEY=
# --model google/...
GEMINI_API_KEY=
# --model vertex/anthropic/... or vertex/google/...: the path of a Google Cloud service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
# --model openai-compatible/... reads OPENAI_API_KEY when the server needs a key
